# Optional MarketBase objective-data settings.
# Install the matching provider through: pip install ".[data-cn]"

# Tushare is optional and requires an account token.
# TUSHARE_TOKEN=
# TUSHARE_API_URL=http://api.waditu.com
# TUSHARE_TRADE_DATE=
# TUSHARE_DAILY_ADJ=qfq

# Provider-call timeouts in seconds.
# MARKETBASE_SOURCE_CALL_TIMEOUT_SEC=60
# MARKETBASE_SNAPSHOT_CALL_TIMEOUT_SEC=60
# MARKETBASE_DAILY_CALL_TIMEOUT_SEC=20

# Eastmoney pacing controls in seconds.
# MARKETBASE_EASTMONEY_MIN_INTERVAL_SEC=
# MARKETBASE_EASTMONEY_JITTER_SEC=
