+    price: float = 45.0,
+    price_band: str = "shadow_40_50",
+    named_pivot: float = 44.8,
+) -> dict[str, object]:
+    return {
+        "code": code,
+        "name": "平安银行",
+        "market": "sz",
+        "price": price,
+        "amount": 55_000_000,
